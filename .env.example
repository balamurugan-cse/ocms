# GEMINI_API_KEY: Required for Gemini AI API calls (if configured).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server & Runtime Configuration
NODE_ENV="development"
PORT=3000
CLIENT_URL="http://localhost:3000"
API_BASE_URL="http://localhost:3000/api/v1"

# Security & Session Secrets
JWT_ACCESS_SECRET="CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_RANDOM_SECRET_32_CHARS"
JWT_REFRESH_SECRET="CHANGE_THIS_TO_ANOTHER_RANDOM_SECRET_FOR_REFRESH_TOKENS"

# Email Delivery (SMTP Configuration)
# Note: Configure real SMTP credentials to deliver verification & notification emails.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="grievance@dmice.ac.in"
SMTP_PASS="your_secure_app_password"
MAIL_FROM="DMI OCMS Grievance Portal <grievance@dmice.ac.in>"
EMAIL_TOKEN_TTL_MINUTES=20

# Storage & Upload Directory
UPLOAD_DIR="./data/uploads"
